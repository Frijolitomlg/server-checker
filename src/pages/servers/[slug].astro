---
import Layout from '../../layouts/Layout.astro';
import { getServers } from '../../lib/servers';
import { renderTutorialMarkdown } from '../../lib/tutorial-markdown';

export const prerender = false;

const servers = await getServers();
const server = servers.find(({ slug }) => slug === Astro.params.slug);
if (!server) Astro.response.status = 404;
---

<Layout
	title={server ? `${server.name} — Legit Gaming` : 'Server not found — Legit Gaming'}
	description={server ? `Join ${server.name} with this setup guide and step-by-step tutorial.` : 'This server guide could not be found.'}
>
	<main class="guide-page">
		<header class="guide-topbar">
			<a href="/" class="brand"><img class="brand__mark" src="/legit-gaming-logo.png" alt="" />Legit Gaming</a>
			<a href="/" class="back-link"><span aria-hidden="true">←</span> All servers</a>
		</header>

		{server ? (
			<>
				<section class="hero">
					<div class="eyebrow">{server.game.toUpperCase()} SERVER GUIDE</div>
					<h1>{server.name}</h1>
					<p class="hero__copy">Everything you need to get set up and join the crew.</p>
					<div class="hero__links">
						{server.modpackUrl ? (
							<a class="button button--primary" href={server.modpackUrl} target="_blank" rel="noreferrer">
								Download modpack <span aria-hidden="true">↗</span>
							</a>
						) : (
							<span class="button button--disabled" aria-disabled="true">Modpack link coming soon</span>
						)}
						{server.mapUrl && (
							<a class="button button--secondary" href={server.mapUrl} target="_blank" rel="noreferrer">
								Explore the map <span aria-hidden="true">↗</span>
							</a>
						)}
					</div>
				</section>

				<section class="join-card" aria-label="Server connection details">
					<div class="join-card__label"><span class="status-dot"></span> SERVER ADDRESS</div>
					<code>{server.serverAddress}</code>
					<p>Copy this address into the multiplayer or server browser screen in your game.</p>
				</section>

				<section class="tutorial" aria-labelledby="tutorial-title">
					<div class="tutorial-heading">
						<div>
							<div class="eyebrow">YOUR QUICK-START GUIDE</div>
							<h2 id="tutorial-title">Let’s get you in</h2>
						</div>
						<span class="step-count" data-step-count>Step 1 of {server.steps.length}</span>
					</div>
					<div class="progress-track" aria-hidden="true"><span data-progress></span></div>

					<div class="tutorial-card">
						<div class="tutorial-card__content">
							<div class="tutorial-card__number" data-active-number>01</div>
							<div class="step-list">
								{server.steps.map((step, index) => (
									<article class="tutorial-step" data-tutorial-step data-index={index} aria-hidden={index !== 0}>
										<div class="eyebrow">STEP {String(index + 1).padStart(2, '0')}</div>
										<h3>{step.title}</h3>
										<div class="tutorial-copy" set:html={renderTutorialMarkdown(step.content)}></div>
									</article>
								))}
							</div>
							<div class="tutorial-controls">
								<button class="button button--secondary" type="button" data-previous disabled>
									<span aria-hidden="true">←</span> Previous
								</button>
								<button class="button button--primary" type="button" data-next>
									Next step <span aria-hidden="true">→</span>
								</button>
							</div>
						</div>
						<div class="screenshot-area">
							{server.steps.map((step, index) => (
								<div class="tutorial-image" data-tutorial-image data-index={index} aria-hidden={index !== 0}>
									{step.screenshotUrl ? (
										<img src={step.screenshotUrl} alt={`Screenshot for ${step.title}`} loading="lazy" />
									) : (
										<div class="screenshot-placeholder">
											<div class="placeholder-window" aria-hidden="true">
												<div class="placeholder-window__bar"><i></i><i></i><i></i></div>
												<div class="placeholder-window__scene">
													<span class="placeholder-window__sun"></span>
													<span class="placeholder-window__mountain"></span>
													<span class="placeholder-window__mountain placeholder-window__mountain--back"></span>
												</div>
												<div class="placeholder-window__caption">YOUR SCREENSHOT GOES HERE</div>
											</div>
											<span>Screenshot placeholder</span>
										</div>
									)}
								</div>
							))}
						</div>
					</div>
				</section>

				<footer class="guide-footer">
					<a href="/">← Back to all servers</a>
					<a href="/admin">Manage this guide <span aria-hidden="true">↗</span></a>
				</footer>
			</>
		) : (
			<section class="not-found">
				<div class="eyebrow">404 — WRONG TURN</div>
				<h1>This guide is off the map.</h1>
				<p>That page isn’t here, but the server list can point you in the right direction.</p>
				<a class="button button--primary" href="/">Browse servers <span aria-hidden="true">→</span></a>
			</section>
		)}
	</main>
</Layout>

<script>
	const steps = Array.from(document.querySelectorAll<HTMLElement>('[data-tutorial-step]'));
	const images = Array.from(document.querySelectorAll<HTMLElement>('[data-tutorial-image]'));
	const previous = document.querySelector<HTMLButtonElement>('[data-previous]');
	const next = document.querySelector<HTMLButtonElement>('[data-next]');
	const count = document.querySelector<HTMLElement>('[data-step-count]');
	const progress = document.querySelector<HTMLElement>('[data-progress]');
	const activeNumber = document.querySelector<HTMLElement>('[data-active-number]');
	let activeIndex = 0;

	function showStep(index: number) {
		activeIndex = Math.max(0, Math.min(index, steps.length - 1));
		steps.forEach((step, stepIndex) => {
			step.hidden = stepIndex !== activeIndex;
			step.setAttribute('aria-hidden', String(stepIndex !== activeIndex));
		});
		images.forEach((image, imageIndex) => {
			image.hidden = imageIndex !== activeIndex;
			image.setAttribute('aria-hidden', String(imageIndex !== activeIndex));
		});
		if (previous) previous.disabled = activeIndex === 0;
		if (next) {
			next.disabled = activeIndex === steps.length - 1;
			next.innerHTML = activeIndex === steps.length - 1
				? 'All done <span aria-hidden="true">✓</span>'
				: 'Next step <span aria-hidden="true">→</span>';
		}
		if (count) count.textContent = `Step ${activeIndex + 1} of ${steps.length}`;
		if (activeNumber) activeNumber.textContent = String(activeIndex + 1).padStart(2, '0');
		if (progress) progress.style.width = `${((activeIndex + 1) / steps.length) * 100}%`;
	}

	previous?.addEventListener('click', () => showStep(activeIndex - 1));
	next?.addEventListener('click', () => showStep(activeIndex + 1));
	showStep(0);

	for (const image of document.querySelectorAll<HTMLImageElement>('.tutorial-image img')) {
		image.addEventListener('error', () => {
			const placeholder = document.createElement('div');
			placeholder.className = 'screenshot-placeholder screenshot-placeholder--error';
			placeholder.textContent = 'Screenshot could not be loaded.';
			image.replaceWith(placeholder);
		}, { once: true });
	}
</script>

<style>
	:global(body) {
		background: #141313;
	}

	.guide-page {
		--panel: #1d1b1b;
		--muted: #aaa5a2;
		--line: rgba(255,255,255,.12);
		--accent: #d8242b;
		min-height: 100vh;
		padding: 0 6vw 36px;
		background: #141313;
		color: #f7f3f0;
	}

	.guide-topbar,
	.brand,
	.back-link,
	.hero__links,
	.tutorial-heading,
	.tutorial-controls,
	.guide-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.guide-topbar {
		max-width: 1200px;
		height: 78px;
		margin: 0 auto;
		border-bottom: 1px solid rgba(255,255,255,.12);
	}

	.brand {
		justify-content: flex-start;
		gap: 11px;
		color: #fff;
		font-size: 14px;
		font-weight: 700;
		text-decoration: none;
	}

	.brand__mark {
		display: block;
		flex: none;
		width: 37px;
		height: 37px;
		object-fit: cover;
	}

	.back-link,
	.guide-footer a {
		gap: 8px;
		color: #e8e3df;
		font-size: 12px;
		text-decoration: none;
	}

	.back-link:hover,
	.guide-footer a:hover {
		color: var(--accent);
	}

	.hero,
	.tutorial,
	.join-card,
	.guide-footer,
	.not-found {
		width: min(100%, 980px);
		margin-right: auto;
		margin-left: auto;
	}

	.hero {
		padding: 66px 0 34px;
	}

	.eyebrow {
		color: var(--accent);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: .16em;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	.hero h1,
	.not-found h1 {
		margin: 14px 0 10px;
		font-size: clamp(36px, 7vw, 66px);
		letter-spacing: -.055em;
		line-height: 1.05;
	}

	.hero__copy,
	.not-found p {
		color: var(--muted);
		font-size: 15px;
		line-height: 1.65;
	}

	.hero__links {
		justify-content: flex-start;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 25px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 13px;
		border: 1px solid transparent;
		border-radius: 2px;
		padding: 12px 16px;
		font-size: 12px;
		font-weight: 700;
		text-decoration: none;
	}

	.button--primary {
		background: var(--accent);
		color: #fff;
	}

	.button--secondary {
		border-color: rgba(255,255,255,.35);
		background: transparent;
		color: #f7f3f0;
	}

	.button--disabled {
		border-color: rgba(255,255,255,.18);
		background: #201e1d;
		color: #938b87;
		cursor: not-allowed;
	}

	.join-card,
	.tutorial-card {
		border: 1px solid var(--line);
		border-radius: 3px;
		background: var(--panel);
	}

	.join-card {
		padding: 21px 24px;
	}

	.join-card__label {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 12px;
		color: #d0c8c3;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: .13em;
	}

	.status-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #70dda5;
		box-shadow: 0 0 12px rgba(112,221,165,.65);
	}

	.join-card code {
		display: block;
		overflow-wrap: anywhere;
		color: #f6f5fb;
		font-size: clamp(17px, 3vw, 24px);
		font-weight: 600;
	}

	.join-card p {
		margin: 10px 0 0;
		color: var(--muted);
		font-size: 12px;
		line-height: 1.5;
	}

	.tutorial {
		margin-top: 52px;
	}

	.tutorial-heading {
		margin-bottom: 18px;
	}

	h2 {
		margin: 8px 0 0;
		font-size: 27px;
		letter-spacing: -.04em;
	}

	.step-count {
		color: var(--muted);
		font-size: 12px;
	}

	.progress-track {
		height: 4px;
		overflow: hidden;
		margin-bottom: 16px;
		border-radius: 10px;
		background: #383433;
	}

	.progress-track span {
		display: block;
		height: 100%;
		border-radius: inherit;
		background: var(--accent);
		transition: width .25s ease;
	}

	.tutorial-card {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(280px, .92fr);
		min-height: 320px;
		overflow: hidden;
	}

	.tutorial-card__content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: clamp(23px, 4vw, 38px);
	}

	.tutorial-card__number {
		margin-bottom: 23px;
		color: #928b88;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: .12em;
	}

	.step-list {
		flex: 1;
		width: 100%;
	}

	.tutorial-step h3 {
		margin: 10px 0;
		font-size: 23px;
		letter-spacing: -.035em;
	}

	.tutorial-step p {
		max-width: 440px;
		margin-bottom: 25px;
		color: var(--muted);
		font-size: 13px;
		line-height: 1.8;
		white-space: pre-line;
	}

	.tutorial-step:not([hidden]) {
		animation: step-reveal .3s ease-out both;
	}

	.tutorial-image:not([hidden]) {
		animation: image-reveal .38s ease-out both;
	}

	:global(.tutorial-copy p) {
		margin: 0 0 12px;
		color: var(--muted);
		font-size: 13px;
		line-height: 1.8;
	}

	:global(.tutorial-copy h3),
	:global(.tutorial-copy h4),
	:global(.tutorial-copy h5) {
		margin: 16px 0 8px;
		font-size: 15px;
	}

	:global(.tutorial-copy ul),
	:global(.tutorial-copy ol) {
		display: grid;
		gap: 7px;
		margin: 0 0 14px;
		padding-left: 20px;
		color: var(--muted);
		font-size: 13px;
		line-height: 1.7;
	}

	:global(.tutorial-copy strong) {
		color: #f5f4fb;
	}

	:global(.tutorial-copy code) {
		border: 1px solid var(--line);
		border-radius: 2px;
		padding: 2px 5px;
		background: #111;
		color: #f07b7d;
		font-size: .92em;
	}

	:global(.tutorial-copy a) {
		color: #f07b7d;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	.tutorial-controls {
		width: 100%;
		gap: 10px;
		margin-top: 12px;
	}

	.tutorial-controls button {
		border-radius: 9px;
		padding: 11px 13px;
		cursor: pointer;
	}

	.tutorial-controls button:disabled {
		cursor: not-allowed;
		opacity: .45;
	}

	.screenshot-area {
		display: grid;
		min-height: 320px;
		place-items: center;
		padding: 26px;
		background:
			radial-gradient(circle at 50% 45%, rgba(216, 36, 43, .16), transparent 60%),
			#191717;
	}

	.tutorial-image {
		width: 100%;
	}

	.tutorial-image img {
		display: block;
		width: 100%;
		max-height: 300px;
		border: 1px solid #514a47;
		border-radius: 3px;
		object-fit: contain;
	}

	.screenshot-placeholder {
		display: flex;
		min-height: 235px;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 13px;
		color: #818091;
		font-size: 10px;
		letter-spacing: .08em;
	}

	.placeholder-window {
		width: min(100%, 310px);
		overflow: hidden;
		border: 1px solid #514a47;
		border-radius: 3px;
		background: #1d1b1b;
		box-shadow: 0 18px 35px rgba(0,0,0,.32);
	}

	.placeholder-window__bar {
		display: flex;
		gap: 5px;
		padding: 10px;
	}

	.placeholder-window__bar i {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #575667;
	}

	.placeholder-window__scene {
		position: relative;
		height: 110px;
		overflow: hidden;
		background: linear-gradient(160deg, #343a3b, #57737a 65%, #887d60);
	}

	.placeholder-window__sun {
		position: absolute;
		top: 17px;
		right: 25px;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		background: #e3c88a;
		box-shadow: 0 0 25px rgba(255,222,157,.45);
	}

	.placeholder-window__mountain {
		position: absolute;
		right: -12px;
		bottom: -48px;
		width: 75%;
		height: 120px;
		transform: rotate(38deg);
		background: #3b4847;
	}

	.placeholder-window__mountain--back {
		right: 44%;
		bottom: -71px;
		width: 68%;
		background: #46584d;
	}

	.placeholder-window__caption {
		padding: 12px;
		color: #aaa9b5;
		font-size: 8px;
		letter-spacing: .15em;
	}

	.screenshot-placeholder--error {
		color: #d3a9a9;
		letter-spacing: 0;
	}

	.guide-footer {
		gap: 20px;
		margin-top: 28px;
		padding: 20px 2px;
		border-top: 1px solid rgba(255,255,255,.12);
	}

	.not-found {
		padding: 15vh 0;
	}

	@keyframes step-reveal {
		from { opacity: 0; transform: translateY(8px); }
		to { opacity: 1; transform: translateY(0); }
	}

	@keyframes image-reveal {
		from { opacity: .4; transform: scale(.985); }
		to { opacity: 1; transform: scale(1); }
	}

	@media (prefers-reduced-motion: reduce) {
		.tutorial-step:not([hidden]),
		.tutorial-image:not([hidden]) {
			animation: none;
		}
	}

	.not-found p {
		margin-bottom: 24px;
	}

	[hidden] {
		display: none !important;
	}

	@media (max-width: 720px) {
		.guide-page {
			padding: 0 20px 28px;
		}

		.hero {
			padding-top: 48px;
		}

		.tutorial-card {
			grid-template-columns: 1fr;
		}

		.screenshot-area {
			min-height: 230px;
			grid-row: 1;
			padding: 18px;
		}

		.screenshot-placeholder {
			min-height: 200px;
		}
	}

	@media (max-width: 420px) {
		.guide-footer {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
