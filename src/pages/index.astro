---
import Layout from '../layouts/Layout.astro';
import minecraftModded from '../assets/minecraft-modded.png';
import minecraftVanilla from '../assets/minecraft-vanilla.png';
import projectZomboid from '../assets/project-zomvoid.png';

const serverDetails = [
	{
		name: 'Minecraft Vanilla',
		version: 'Checking...',
		image: minecraftVanilla,
	},
	{
		name: 'Minecraft Modded',
		version: 'Checking...',
		image: minecraftModded,
	},
	{
		name: 'Project Zomboid',
		version: 'Checking...',
		image: projectZomboid,
	},
];
---

<Layout>
	<main class="page-shell">
		<header class="page-title">
			<h1>Legit Gaming Servers Status</h1>
		</header>

		<section class="server-grid" aria-label="Gaming server status">
			{serverDetails.map((server) => (
				<article class="server-card" data-server-name={server.name}>
					<h2>{server.name}</h2>
					<img src={server.image.src} alt={`${server.name} server`} />
					<div class="detail-row">
						<span>Version:</span>
						<strong class="server-version">{server.version}</strong>
					</div>
					<div class="detail-row">
						<span>Status:</span>
						<strong class="server-status">Checking...</strong>
					</div>
					<div class="detail-row diagnostic-row">
						<span>Code:</span>
						<strong class="server-code">-</strong>
					</div>
				</article>
			))}
		</section>

		<section class="service-links" aria-label="Web server links">
			<div class="service-row" data-service-url="http://berds-komga-comics.playit.plus:13163/">
				<span class="service-indicator" aria-label="Checking status"></span>
				<a href="http://berds-komga-comics.playit.plus:13163/" target="_blank" rel="noreferrer">
					Berds Komga Comics
				</a>
			</div>
		</section>
	</main>
</Layout>

<script>
	type ServerStatus = { name: string; online: boolean; statusCode: number; output: string; version?: string | null };

	const fallbackStatuses: ServerStatus[] = [
		{ name: 'Minecraft Vanilla', online: false, statusCode: 0, output: '', version: 'Unknown' },
		{ name: 'Minecraft Modded', online: false, statusCode: 0, output: '', version: 'Unknown' },
		{ name: 'Project Zomboid', online: false, statusCode: 0, output: '', version: 'Unknown' },
	];

	function renderStatus(servers: ServerStatus[]) {
		for (const server of servers) {
			const card = document.querySelector<HTMLElement>(`[data-server-name="${server.name}"]`);
			const status = card?.querySelector<HTMLElement>('.server-status');
			const version = card?.querySelector<HTMLElement>('.server-version');
							const code = card?.querySelector<HTMLElement>('.server-code');
							if (!card || !status || !version || !code) continue;

			card.classList.toggle('online', server.online);
			card.classList.toggle('offline', !server.online);
			status.textContent = server.online ? 'Online' : 'Offline';
			version.textContent = server.version || 'Unknown';
							code.textContent = String(server.statusCode);
		}
	}

	async function checkServers() {
		try {
			const response = await fetch('/api/status');
			if (!response.ok) throw new Error('Status request failed');
			renderStatus(await response.json());
		} catch {
			renderStatus(fallbackStatuses);
		}
	}

	async function checkWebServices() {
		const row = document.querySelector<HTMLElement>('[data-service-url]');
		const indicator = row?.querySelector<HTMLElement>('.service-indicator');
		if (!indicator) return;

		try {
			const response = await fetch('/api/web-status');
			const result = await response.json();
			indicator.classList.toggle('online', result.online);
			indicator.classList.toggle('offline', !result.online);
			indicator.setAttribute('aria-label', result.online ? 'Online' : 'Offline');
		} catch {
			indicator.classList.add('offline');
			indicator.setAttribute('aria-label', 'Offline');
		}
	}

	checkServers();
	checkWebServices();
	setInterval(checkServers, 30_000);
	setInterval(checkWebServices, 30_000);
</script>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		background: #171717;
		color: #fff;
		font-family: Inter, 'Segoe UI', sans-serif;
	}

	.page-shell {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 128px;
		overflow: hidden;
		padding: 112px 48px 40px;
		background: #171717;
	}

	.page-title {
		padding: 10px;
		text-align: center;
	}

	h1 {
		margin: 0;
		font-family: 'Cal Sans', Inter, sans-serif;
		font-size: clamp(2.5rem, 5vw, 3.75rem);
		font-weight: 400;
		line-height: 1.1;
	}

	.server-grid {
		display: flex;
		align-items: flex-start;
		justify-content: center;
		gap: 80px;
		width: min(100%, 976px);
	}

	.service-links {
		width: min(100%, 976px);
	}

	.service-row {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 12px;
		font-size: 1.25rem;
	}

	.service-row a {
		color: #fff;
	}

	.service-indicator {
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: #737373;
	}

	.service-indicator.online {
		background: #a3e635;
	}

	.service-indicator.offline {
		background: #b91c1c;
	}

	.server-card {
		display: flex;
		width: 288px;
		flex-direction: column;
		align-items: stretch;
		gap: 14px;
	}

	.server-card h2 {
		min-height: 54px;
		margin: 0;
		padding: 10px;
		text-align: center;
		font-size: 1.75rem;
		font-weight: 400;
		line-height: 1.15;
	}

	.server-card img {
		width: 100%;
		aspect-ratio: 1;
		border: 2px solid #a3e635;
		border-radius: 24px;
		object-fit: cover;
	}

	.server-card.offline img {
		border-color: #b91c1c;
	}

	.detail-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 0 20px;
		font-size: 1.875rem;
		line-height: 1.2;
	}

	.detail-row strong {
		font-weight: 700;
	}

	.server-version {
		font-size: 16px;
	}

	.server-status {
		color: #a3e635;
	}

	.server-card.offline .server-status {
		color: #b91c1c;
	}

	.server-output {
		display: none;
	}

	footer {
		display: flex;
		width: 224px;
		align-items: center;
		gap: 6px;
		padding: 10px;
		font-size: 0.75rem;
	}

	footer img {
		width: 41px;
		height: 43px;
		object-fit: cover;
	}

	@media (max-width: 1100px) {
		.page-shell {
			gap: 88px;
			padding-right: 24px;
			padding-left: 24px;
		}

		.server-grid {
			gap: 32px;
		}
	}

	@media (max-width: 760px) {
		.page-shell {
			gap: 64px;
			padding: 56px 16px 32px;
		}

		.server-grid {
			flex-direction: column;
			align-items: center;
			gap: 56px;
		}

		.server-card {
			width: min(100%, 288px);
		}
	}
</style>