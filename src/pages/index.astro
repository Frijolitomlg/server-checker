---
import Layout from '../layouts/Layout.astro';
import minecraftVanillaBg from '../assets/Minecraft-Vanilla-BG.png';
import minecraftModdedBg from '../assets/Minecraft-modded-BG.png';
import zomboidBg from '../assets/Zomboid-BG.png';
import komgaBg from '../assets/Komga-bg.png';
import mcMapIcon from '../assets/mc-map-icon.png';
import fabricIcon from '../assets/fabric-icon.png';

//IDK what this is for, but I guess it works

const komgaUrl = import.meta.env.PUBLIC_KOMGA_URL;


// this loads the cards info and content
const servers = [
	{
		key: 'Minecraft Vanilla',
		title: 'Minecraft Vanilla',
		version: '1.26.2',
		titleFont: "'Press Start 2P'",
		background: minecraftVanillaBg,
		icons: [
			{ src: mcMapIcon, href: 'http://roosevelt-intact.tun.ply.gg:44435', alt: 'Minecraft Map' },
			{ src: fabricIcon, href: '#', alt: 'Fabric Link' },
		],
		compact: false,
	},
	{
		key: 'Minecraft Modded',
		title: 'Minecraft Modded',
		version: '1.21.1',
		titleFont: "'Press Start 2P'",
		background: minecraftModdedBg,
		icons: [{ src: fabricIcon, href: '#', alt: 'Fabric Link' }],
		compact: false,
	},
	{
		key: 'Project Zomboid',
		title: 'Project Zomboid',
		version: 'B 42',
		titleFont: "'Creepster'",
		background: zomboidBg,
		icons: [],
		compact: true,
	},
];
---

<Layout>
	<main class="page">
		<header class="page-header">
			<div class="page-header__inner">
				<h1 class="page-header__title">Legit Gaming</h1>
				<p class="page-header__subtitle">Server Status Checker</p>
			</div>
		</header>

		<section class="server-list" aria-label="Gaming server status">
			{
				servers.map((server) => (
					<article
						class="server-card"
						data-server-name={server.key}
						style={`--card-bg: url('${server.background.src}'); --title-font: ${server.titleFont};`}
					>
						<h2 class="server-card__title">{server.title}</h2>

						<div class="server-card__body">
							<dl class:list={['server-details', { 'server-details--compact': server.compact }]}>
								<div class="server-details__row">
									<dt class="server-details__label">Version:</dt>
									<dd class="server-details__value">{server.version}</dd>
								</div>
								<div class="server-details__row">
									<dt class="server-details__label">Status:</dt>
									<dd class="server-details__value server-status" data-status>
										Checking...
									</dd>
								</div>
								<div class="server-details__row">
									<dt class="server-details__label">Code</dt>
									<dd class="server-details__value" data-code>-</dd>
								</div>
							</dl>

							{server.icons.length > 0 && (
								<div class="server-icons">
									{server.icons.map((icon) => (
										icon.href ? (
											<a
												class="server-icon-button"
												href={icon.href}
												target="_blank"
												rel="noreferrer"
												aria-label={icon.alt}
											>
												<img
													class="server-icon"
													src={icon.src.src}
													alt={icon.alt}
													width="64"
													height="64"
													loading="lazy"
													decoding="async"
												/>
											</a>
										) : (
											<img
												class="server-icon"
												src={icon.src.src}
												alt={icon.alt}
												width="64"
												height="64"
												loading="lazy"
												decoding="async"
											/>
										)
									))}
								</div>
							)}
						</div>

						<p class="visually-hidden" data-output aria-live="polite">
							Waiting for probe...
						</p>
					</article>
				))
			}

			<article
				class="server-card server-card--komga"
				style={`--card-bg: url('${komgaBg.src}'); --title-font: 'Coustard';`}
			>
				<h2 class="server-card__title server-card__title--large">Komga Readings</h2>
				<div class="komga-body">
					<div class="komga-body__row">
						<a class="komga-login" href="https://berds-komga-comics.playit.plus:13163/">
							Log in
						</a>
					</div>
				</div>
			</article>
		</section>
	</main>
</Layout>

<script>
	type ServerStatus = { name: string; online: boolean; statusCode: number; output: string };

	const offlineFallback: Omit<ServerStatus, 'name'> = {
		online: false,
		statusCode: 503,
		output: 'Status endpoint unreachable',
	};

	function renderStatus(servers: ServerStatus[]) {
		for (const server of servers) {
			const card = document.querySelector<HTMLElement>(`[data-server-name="${server.name}"]`);
			const status = card?.querySelector<HTMLElement>('[data-status]');
			const code = card?.querySelector<HTMLElement>('[data-code]');
			const output = card?.querySelector<HTMLElement>('[data-output]');
			if (!card || !status || !code || !output) continue;

			card.classList.toggle('online', server.online);
			card.classList.toggle('offline', !server.online);
			status.textContent = server.online ? 'Online' : 'Offline';
			code.textContent = String(server.statusCode);
			output.textContent = server.output;
		}
	}

	async function checkServers() {
		try {
			const response = await fetch('/api/status');
			if (!response.ok) throw new Error(`Status request failed with HTTP ${response.status}`);
			renderStatus(await response.json());
		} catch (error) {
			renderStatus(
				Array.from(document.querySelectorAll<HTMLElement>('[data-server-name]')).map((card) => ({
					name: card.dataset.serverName ?? '',
					...offlineFallback,
					output: error instanceof Error ? error.message : offlineFallback.output,
				})),
			);
		}
	}

	checkServers();
	setInterval(checkServers, 30_000);
</script>

<style>
	.page {
		width: 100%;
		max-width: 1440px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: stretch;
		background: #171717;
		overflow: hidden;
	}

	.page-header {
		padding: 40px 20px 112px;
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 10px;
	}

	.page-header__inner {
		width: 100%;
		max-width: 505px;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		align-items: center;
		gap: 20px;
	}

	.page-header__title {
		margin: 0;
		text-align: center;
		color: #b91c1c;
		font-family: 'Bungee', Inter, sans-serif;
		font-size: 60px;
		font-weight: 400;
		line-height: 1.05;
	}

	.page-header__subtitle {
		margin: 0;
		align-self: stretch;
		text-align: center;
		color: #fff;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 18px;
		font-weight: 400;
	}

	.server-list {
		display: flex;
		flex-direction: column;
		align-items: stretch;
	}

	.server-card {
		position: relative;
		height: 384px;
		padding: 48px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		align-items: flex-start;
		overflow: hidden;
		background-color: #171717;
		background-image:
			linear-gradient(rgba(9, 9, 9, 0.15), rgba(9, 9, 9, 0.45)),
			var(--card-bg);
		background-repeat: no-repeat;
		background-position: center;
		background-size: cover;
	}

	.server-card__title {
		margin: 0;
		max-width: 100%;
		color: #fff;
		font-family: var(--title-font, 'Press Start 2P'), Inter, sans-serif;
		font-size: 36px;
		font-weight: 400;
		line-height: 1.15;
	}

	.server-card__title--large {
		font-size: 60px;
	}

	.server-card__body {
		display: flex;
		justify-content: flex-start;
		align-items: flex-end;
		gap: 48px;
	}

	.server-details {
		width: 320px;
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 14px;
	}

	.server-details--compact {
		width: 288px;
		gap: 28px;
	}

	.server-details__row {
		align-self: stretch;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
	}

	.server-details__label,
	.server-details__value {
		margin: 0;
		color: #fff;
		font-family: Inter, 'Segoe UI', sans-serif;
		font-size: 30px;
		line-height: 1.2;
	}

	.server-details__label {
		font-weight: 400;
	}

	.server-details__value {
		font-weight: 700;
		text-align: right;
	}

	.server-status {
		color: #65a30d;
	}

	.server-card.offline .server-status {
		color: #dc2626;
	}

	.server-icons {
		display: flex;
		justify-content: flex-start;
		align-items: flex-start;
		gap: 14px;
	}

	.server-icon {
		width: 64px;
		height: 64px;
		object-fit: contain;
	}

	.server-icon-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		background: transparent;
		border: 0;
		border-radius: 0;
		text-decoration: none;
		transition: opacity 0.15s ease;
	}

	.server-icon-button:hover,
	.server-icon-button:focus-visible {
		opacity: 0.8;
		background: transparent;
		border-color: transparent;
	}

	.server-card--komga {
		align-items: flex-end;
	}

	.komga-body {
		width: 288px;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 28px;
	}

	.komga-body__row {
		align-self: stretch;
		display: flex;
		justify-content: flex-end;
		align-items: center;
		gap: 28px;
	}

	.komga-login {
		color: #fff;
		font-family: Inter, 'Segoe UI', sans-serif;
		font-size: 30px;
		font-weight: 700;
		line-height: 1.2;
		text-align: right;
		text-decoration: none;
	}

	a.komga-login {
		border-bottom: 3px solid #b91c1c;
		padding-bottom: 4px;
		transition: color 0.15s ease, border-color 0.15s ease;
	}

	a.komga-login:hover,
	a.komga-login:focus-visible {
		color: #b91c1c;
		border-color: #fff;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0 0 0 0);
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 1280px) {
		.server-card {
			padding: 40px;
		}

		.server-details,
		.server-details--compact {
			width: 300px;
		}
	}

	@media (max-width: 1024px) {
		.page-header {
			padding: 40px 20px 72px;
		}

		.page-header__title {
			font-size: clamp(2.5rem, 8vw, 3.75rem);
		}

		.server-card {
			height: auto;
			min-height: 320px;
			padding: 32px;
		}

		.server-card__title {
			font-size: 28px;
		}

		.server-card__title--large {
			font-size: 40px;
		}

		.server-details,
		.server-details--compact {
			width: 100%;
		}
	}

	@media (max-width: 720px) {
		.page-header {
			padding: 32px 20px 56px;
		}

		.server-card {
			min-height: 0;
			padding: 28px 20px 36px;
			gap: 40px;
		}

		.server-card__body {
			flex-direction: column;
			align-items: flex-start;
			gap: 28px;
		}

		.server-details__label,
		.server-details__value,
		.komga-login {
			font-size: 20px;
		}

		.komga-body {
			width: 100%;
		}
	}
</style>
