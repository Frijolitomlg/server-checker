---
import Layout from '../layouts/Layout.astro';
import heroImage from '../assets/Minecraft-TARDIS-Animal-Gathering.png';
import minecraftVanillaBg from '../assets/Minecraft-Vanilla-BG.png';
import minecraftModdedBg from '../assets/Minecraft-modded-BG.png';
import zomboidBg from '../assets/Zomboid-BG.png';
import komgaBg from '../assets/Komga-bg.png';
import { getServers } from '../lib/servers';

const serverConfigs = await getServers();
const presentation: Record<string, { background: ImageMetadata; eyebrow: string }> = {
	'minecraft-vanilla': { background: minecraftVanillaBg, eyebrow: 'SURVIVAL · VANILLA' },
	'minecraft-modded': { background: minecraftModdedBg, eyebrow: 'SURVIVAL · MODDED' },
	'project-zomboid': { background: zomboidBg, eyebrow: 'SURVIVAL · CO-OP' },
};
const servers = serverConfigs.map((server) => {
	const visual = presentation[server.slug];
	if (!visual) throw new Error(`Missing homepage artwork for server "${server.slug}".`);
	return { ...server, ...visual };
});
const videos = [
	{ id: 'U19qAGrxekQ', title: 'Introducing GUN', kind: 'SHORT', published: 'APR 11, 2026' },
	{ id: 'J4nJOc67cGM', title: 'FrijolitoMLG Short', kind: 'SHORT', published: 'RECENT' },
	{ id: '7kFxD8zgTXk', title: 'FrijolitoMLG Short', kind: 'SHORT', published: 'RECENT' },
	{ id: '_CW4biLwj54', title: 'Y el otro Galil? Ese es otro.', kind: 'SHORT', published: 'OCT 19, 2025' },
	{ id: 'aQ3RQXr0058', title: 'Shut up Blue', kind: 'SHORT', published: 'OCT 19, 2025' },
	{ id: 'h_RvvW9ctoQ', title: 'CSNO con los animales', kind: 'VIDEO', published: 'JUL 13, 2025' },
	{ id: 'wQk82byQ_7g', title: 'BORK EP 1', kind: 'VIDEO', published: 'MAY 03, 2025' },
];
---

<Layout
	title="Legit Gaming — Find your next world"
	description="Find a Legit Gaming server, check its live status and follow the quick-start guide."
>
	<main class="site-shell">
		<header class="topbar">
			<a href="/" class="brand" aria-label="Legit Gaming home">
				<img class="brand__mark" src="/legit-gaming-logo.png" alt="" />
				<span class="brand__name">LEGIT<span>GAMING</span></span>
			</a>
			<nav class="topnav" aria-label="Main navigation">
				<a href="#servers">Servers</a>
				<a href="#community">Community</a>
				<a href="#videos">Videos</a>
				<a class="topnav__admin" href="/admin">Control room <span aria-hidden="true">↗</span></a>
			</nav>
		</header>

		<section class="hero" aria-labelledby="hero-title">
			<div class="hero__copy">
				<p class="eyebrow"><span class="eyebrow__dot"></span> YOUR NEXT WORLD IS WAITING</p>
				<h1 id="hero-title">we are the<br />kind of <span>chaos</span></h1>
				<p class="hero__description">
					But is it working ber? ber... ber?
				</p>
				<div class="hero__actions">
					<a class="button button--primary" href="#servers">Explore servers <span aria-hidden="true">↓</span></a>
					<a class="text-link" href="#community">What is Legit Gaming? <span aria-hidden="true">↗</span></a>
				</div>
				<div class="hero__note">
					<span class="hero__note-icon" aria-hidden="true">✳</span>
					<span><strong>Good games. Good stuped.</strong><br />A little chaos, in the best way.</span>
				</div>
			</div>

			<div class="hero-art" data-parallax-scene aria-label="A look into the Legit Gaming worlds">
				<div class="hero-art__image" style={`--hero-image: url('${heroImage.src}')`} data-parallax data-speed="0.08"></div>
				<div class="hero-art__frame"></div>
				<div class="hero-art__stamp" data-parallax data-speed="-0.12">
					<span class="hero-art__stamp-top">RETARD, TOGETHER</span>
					<strong>NO BREIN<br />JUST GAME</strong>
					<span class="hero-art__stamp-bottom">ZERO PLAN. ALL DAY.</span>
				</div>
				<div class="hero-art__caption" data-parallax data-speed="0.16">
					<span>01 / 03</span>
					<span>ENTER THE WORLD <b aria-hidden="true">↗</b></span>
				</div>
				<span class="hero-art__orb hero-art__orb--one" data-parallax data-speed="-0.2"></span>
				<span class="hero-art__orb hero-art__orb--two" data-parallax data-speed="0.13"></span>
			</div>
			<div class="hero__side-note" aria-hidden="true">PLAY NICE. GO WILD.</div>
		</section>

		<section class="ticker" aria-label="Our server lineup">
			<span>THREE WORLDS</span><i></i><span>ONE CREW</span><i></i><span>TOO MANY CHROMOSOMES</span><i></i><span>WER</span>
		</section>

		<section class="worlds section-wrap" id="servers" aria-labelledby="worlds-title">
			<div class="section-heading">
				<div>
					<p class="eyebrow">PICK YOUR PLAYGROUND</p>
					<h2 id="worlds-title">The worlds <span>are live.</span></h2>
					<p class="section-heading__aside">Choose a world and make Reben lose it.</p>
				</div>
			</div>

			<div class="world-grid">
				{servers.map((server, index) => (
					<article
						class="world-card"
						data-server-name={server.name}
						style={`--world-image: url('${server.background.src}'); --card-index: ${index};`}
					>
						<div class="world-card__art">
							<div class="world-card__topline">
								<span>{server.eyebrow}</span>
								<span class="status-chip" data-status>Checking</span>
							</div>
							<span class="world-card__index">0{index + 1}</span>
							<h3>{server.name}</h3>
							<div class="world-card__image-label">LEGIT GAMING <span>✳</span></div>
						</div>
						<div class="world-card__details">
							<div class="world-card__summary">
								<span>SERVER ADDRESS</span>
								<code>{server.serverAddress}</code>
							</div>
							<div class="world-card__metrics">
								<div><span>GAME VERSION</span><strong data-version>Checking…</strong></div>
								{server.slug !== 'project-zomboid' && (
									<div><span>PLAYERS ONLINE</span><strong data-players>Checking…</strong></div>
								)}
							</div>
							<div class="world-card__actions">
								<a class="button button--small button--light" href={`/servers/${server.slug}`}>
									View server guide <span aria-hidden="true">↗</span>
								</a>
								<div class="world-card__quicklinks">
									{server.mapUrl && <a href={server.mapUrl} target="_blank" rel="noreferrer">Map ↗</a>}
									{server.modpackUrl && <a href={server.modpackUrl} target="_blank" rel="noreferrer">Modpack ↗</a>}
								</div>
							</div>
						</div>
						<p class="visually-hidden" data-output aria-live="polite">Waiting for server status.</p>
					</article>
				))}
			</div>
		</section>

		<section class="community section-wrap" id="community" aria-labelledby="community-title">
			<div class="community__art" style={`--community-image: url('${komgaBg.src}')`}>
				<span>OFF THE CLOCK</span>
				<strong>MORE THAN<br />JUST A SERVER.</strong>
			</div>
			<div class="community__copy">
				<p class="eyebrow">THE LOBBY NEVER CLOSES</p>
				<h2 id="community-title">Stay for the<br /><span>side quests.</span></h2>
				<p>Stick around for some reading. And more reading. Did we mention reading?</p>
				<a class="text-link" href="https://berds-komga-comics.playit.plus:13163/" target="_blank" rel="noreferrer">
					Browse the reading room <span aria-hidden="true">↗</span>
				</a>
			</div>
			<span class="community__deco" data-parallax data-speed="0.06" aria-hidden="true">LG</span>
		</section>

		<section class="videos section-wrap" id="videos" aria-labelledby="videos-title">
			<div class="videos__heading">
				<div>
					<p class="eyebrow">WE ASK ZE QUESTIONS</p>
					<h2 id="videos-title">Watch the <span>chaos.</span></h2>
					<p>Recent Shorts and videos from FrijolitoMLG. Pick one and jump in.</p>
				</div>
			</div>
			<div class="videos__controls" aria-label="Video carousel controls">
				<span>SCROLL FOR MORE</span>
				<div>
					<button class="carousel-button" type="button" data-carousel-prev aria-label="Previous videos" disabled>←</button>
					<button class="carousel-button" type="button" data-carousel-next aria-label="Next videos">→</button>
				</div>
			</div>
			<div class="videos__track" data-video-track role="region" aria-label="Recent videos and Shorts" tabindex="0">
				{videos.map((video) => (
					<a
						class="video-card"
						href={`https://www.youtube.com/${video.kind === 'SHORT' ? 'shorts/' : 'watch?v='}${video.id}`}
						target="_blank"
						rel="noreferrer"
						aria-label={`Watch ${video.title} on YouTube`}
					>
						<div class="video-card__thumbnail">
							<img src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`} alt="" loading="lazy" />
							<span class="video-card__play" aria-hidden="true">▶</span>
							<span class="video-card__tag">{video.kind}</span>
						</div>
						<div class="video-card__copy">
							<strong>{video.title}</strong>
							<span>{video.published}</span>
						</div>
					</a>
				))}
			</div>
		</section>

		<footer class="footer">
			<a href="/" class="brand" aria-label="Legit Gaming home">
				<img class="brand__mark" src="/legit-gaming-logo.png" alt="" />
				<span class="brand__name">LEGIT<span>GAMING</span></span>
			</a>
			<p>Made for the ones who always say “one more round.”</p>
			<a href="/admin">Control room <span aria-hidden="true">↗</span></a>
		</footer>
	</main>
</Layout>

<script>
	type ServerStatus = {
		name: string;
		online: boolean;
		statusCode: number;
		output: string;
		version: string | null;
		players?: number;
		maxPlayers?: number | null;
	};

	const offlineFallback: Omit<ServerStatus, 'name'> = {
		online: false,
		statusCode: 503,
		output: 'Status endpoint unreachable',
		version: null,
	};

	function renderStatus(servers: ServerStatus[]) {
		for (const server of servers) {
			const card = Array.from(document.querySelectorAll<HTMLElement>('[data-server-name]'))
				.find((item) => item.dataset.serverName === server.name);
			const version = card?.querySelector<HTMLElement>('[data-version]');
			const status = card?.querySelector<HTMLElement>('[data-status]');
			const players = card?.querySelector<HTMLElement>('[data-players]');
			const output = card?.querySelector<HTMLElement>('[data-output]');
			if (!card || !version || !status || !output) continue;

			card.classList.toggle('online', server.online);
			card.classList.toggle('offline', !server.online);
			version.textContent = server.version?.trim() || 'Unavailable';
			status.textContent = server.online ? 'Online' : 'Offline';
			if (players) {
				players.textContent = server.online
					? `${server.players ?? 0}${server.maxPlayers != null ? ` / ${server.maxPlayers}` : ''}`
					: 'Unavailable';
			}
			output.textContent = server.output;
			card.classList.remove('status-updated');
			void card.offsetWidth;
			card.classList.add('status-updated');
		}
	}

	async function checkServers() {
		try {
			const response = await fetch('/api/status');
			if (!response.ok) {
				renderStatus(
					Array.from(document.querySelectorAll<HTMLElement>('[data-server-name]')).map((card) => ({
						name: card.dataset.serverName ?? '',
						online: false,
						statusCode: response.status,
						output: `Status request failed with HTTP ${response.status}`,
						version: null,
					})),
				);
				return;
			}
			renderStatus(await response.json());
		} catch (error) {
			renderStatus(
				Array.from(document.querySelectorAll<HTMLElement>('[data-server-name]')).map((card) => ({
					name: card.dataset.serverName ?? '',
					...offlineFallback,
					output: error instanceof Error ? error.message : offlineFallback.output,
				})),
			);
		}
	}

	checkServers();
	setInterval(checkServers, 30_000);

	const parallaxItems = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (parallaxItems.length && !reducedMotion) {
		let frame = 0;
		const updateParallax = () => {
			cancelAnimationFrame(frame);
			frame = requestAnimationFrame(() => {
				const scroll = window.scrollY;
				for (const item of parallaxItems) {
					const speed = Number(item.dataset.speed ?? 0.1);
					const offset = Math.max(-80, Math.min(80, (scroll - item.offsetTop) * speed));
					item.style.setProperty('--parallax-y', `${offset}px`);
				}
			});
		};
		window.addEventListener('scroll', updateParallax, { passive: true });
		updateParallax();
		document.querySelector<HTMLElement>('[data-parallax-scene]')?.addEventListener('pointermove', (event) => {
			const scene = event.currentTarget as HTMLElement;
			const bounds = scene.getBoundingClientRect();
			const x = (event.clientX - bounds.left) / bounds.width - 0.5;
			const y = (event.clientY - bounds.top) / bounds.height - 0.5;
			for (const [index, item] of parallaxItems.entries()) {
				const strength = Number(item.dataset.speed ?? 0.1) * 24;
				item.style.setProperty('--parallax-x', `${x * strength}px`);
				item.style.setProperty('--pointer-y', `${y * strength}px`);
				item.style.setProperty('--parallax-order', String(index));
			}
		});
	}

	const videoTrack = document.querySelector<HTMLElement>('[data-video-track]');
	const previousVideoButton = document.querySelector<HTMLButtonElement>('[data-carousel-prev]');
	const nextVideoButton = document.querySelector<HTMLButtonElement>('[data-carousel-next]');
	if (videoTrack && previousVideoButton && nextVideoButton) {
		const updateVideoControls = () => {
			const maxScroll = videoTrack.scrollWidth - videoTrack.clientWidth;
			previousVideoButton.disabled = videoTrack.scrollLeft <= 1;
			nextVideoButton.disabled = videoTrack.scrollLeft >= maxScroll - 1;
		};
		const scrollVideos = (direction: -1 | 1) => {
			const firstCard = videoTrack.querySelector<HTMLElement>('.video-card');
			if (!firstCard) return;
			const gap = Number.parseFloat(getComputedStyle(videoTrack).columnGap) || 0;
			videoTrack.scrollBy({
				left: direction * (firstCard.offsetWidth + gap),
				behavior: reducedMotion ? 'auto' : 'smooth',
			});
		};
		previousVideoButton.addEventListener('click', () => scrollVideos(-1));
		nextVideoButton.addEventListener('click', () => scrollVideos(1));
		videoTrack.addEventListener('scroll', updateVideoControls, { passive: true });
		window.addEventListener('resize', updateVideoControls);
		updateVideoControls();
	}
</script>

<style>
	:global(body) {
		background: #141313;
	}

	.site-shell {
		--red: #d8242b;
		--red-dark: #9c151c;
		--ink: #141313;
		--surface: #1d1b1b;
		--muted: #aaa5a2;
		--line: rgba(255,255,255,.12);
		overflow: hidden;
		background: var(--ink);
		color: #f7f3f0;
	}

	.topbar,
	.hero,
	.section-wrap,
	.footer {
		position: relative;
		z-index: 3;
		width: min(calc(100% - clamp(36px, 8vw, 144px)), 1440px);
		margin-inline: auto;
	}

	.topbar,
	.footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 82px;
		border-bottom: 1px solid var(--line);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 11px;
		color: #fff;
		text-decoration: none;
	}

	.brand__mark {
		display: block;
		flex: none;
		width: 37px;
		height: 37px;
		object-fit: cover;
	}

	.brand__name {
		font-size: 13px;
		font-weight: 800;
		letter-spacing: .12em;
	}

	.brand__name span {
		display: block;
		margin-top: 2px;
		color: #a9a3a0;
		font-size: 9px;
		letter-spacing: .32em;
	}

	.topnav {
		display: flex;
		align-items: center;
		gap: clamp(18px, 4vw, 46px);
	}

	.topnav a,
	.footer > a:last-child {
		color: #e8e3df;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: .08em;
		text-decoration: none;
		text-transform: uppercase;
		transition: color .18s ease;
	}

	.topnav a:hover,
	.footer > a:last-child:hover {
		color: #ff6268;
	}

	.topnav__admin {
		border: 1px solid rgba(255,255,255,.3);
		border-radius: 2px;
		padding: 10px 13px;
	}

	.hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
		align-items: center;
		gap: clamp(32px, 7vw, 90px);
		min-height: 610px;
		padding-block: 70px 95px;
	}

	.hero__copy {
		position: relative;
		z-index: 1;
		padding-block: 30px;
		animation: rise-in .72s both;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 0 0 21px;
		color: #d0c8c3;
		font-size: 9px;
		font-weight: 700;
		letter-spacing: .19em;
	}

	.eyebrow__dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #e34b50;
		box-shadow: 0 0 16px rgba(227,75,80,.8);
		animation: pulse-dot 2s infinite;
	}

	.hero h1 {
		margin: 0;
		font-family: Bungee, Inter, sans-serif;
		font-size: clamp(45px, 6.3vw, 78px);
		font-weight: 400;
		letter-spacing: -.055em;
		line-height: 1.07;
	}

	.hero h1 span,
	.section-heading h2 span,
	.community__copy h2 span {
		color: var(--red);
	}

	.hero__description {
		max-width: 410px;
		margin: 22px 0 25px;
		color: #b7b0ac;
		font-size: 14px;
		line-height: 1.8;
	}

	.hero__actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 21px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 15px;
		min-height: 46px;
		border: 1px solid transparent;
		border-radius: 2px;
		padding: 0 17px;
		font: inherit;
		font-size: 10px;
		font-weight: 800;
		letter-spacing: .08em;
		text-decoration: none;
		text-transform: uppercase;
		transition: background .18s ease, color .18s ease, border-color .18s ease, transform .18s ease;
	}

	.button:hover {
		transform: translateY(-2px);
	}

	.button--primary {
		background: var(--red);
		color: #fff;
	}

	.button--primary:hover {
		background: #ef343b;
	}

	.text-link {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: #e8e3df;
		font-size: 10px;
		font-weight: 700;
		text-decoration: none;
	}

	.text-link:hover {
		color: #ff656b;
	}

	.hero__note {
		display: flex;
		align-items: center;
		gap: 13px;
		margin-top: 54px;
		color: #a9a3a0;
		font-size: 10px;
		line-height: 1.7;
	}

	.hero__note strong {
		color: #f5f0ec;
		font-size: 11px;
	}

	.hero__note-icon {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border: 1px solid #55403f;
		color: #ef555a;
		font-size: 19px;
	}

	.hero-art {
		position: relative;
		min-height: 440px;
		overflow: visible;
		isolation: isolate;
	}

	.hero-art__image,
	.hero-art__frame {
		position: absolute;
		inset: 0;
	}

	.hero-art__image {
		inset: 4% 5% 10% 7%;
		background-image: var(--hero-image);
		background-position: 54% center;
		background-size: cover;
		filter: saturate(.72);
		transform: scale(1.05);
		translate: var(--parallax-x, 0) calc(var(--parallax-y, 0px) + var(--pointer-y, 0px));
		transition: translate .24s ease-out;
	}

	.hero-art__frame {
		inset: 0 0 7% 13%;
		border: 1px solid rgba(255,255,255,.22);
		border-right-color: rgba(216,36,43,.7);
		border-bottom-color: rgba(216,36,43,.7);
		pointer-events: none;
	}

	.hero-art__stamp {
		position: absolute;
		top: 13%;
		left: -2%;
		display: flex;
		width: 160px;
		height: 160px;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border: 1px solid rgba(255,255,255,.45);
		border-radius: 50%;
		background: rgba(19,18,18,.84);
		text-align: center;
		translate: var(--parallax-x, 0) calc(var(--parallax-y, 0px) + var(--pointer-y, 0px));
		transition: translate .24s ease-out;
	}

	.hero-art__stamp-top,
	.hero-art__stamp-bottom {
		color: #c4bcb8;
		font-size: 7px;
		letter-spacing: .13em;
	}

	.hero-art__stamp strong {
		margin: 8px 0;
		color: #fff;
		font-family: Bungee, sans-serif;
		font-size: 16px;
		font-weight: 400;
		line-height: 1.45;
	}

	.hero-art__caption {
		position: absolute;
		right: 2%;
		bottom: 3%;
		left: 13%;
		display: flex;
		justify-content: space-between;
		color: #f3eeea;
		font-size: 8px;
		font-weight: 700;
		letter-spacing: .16em;
		translate: var(--parallax-x, 0) calc(var(--parallax-y, 0px) + var(--pointer-y, 0px));
		transition: translate .24s ease-out;
